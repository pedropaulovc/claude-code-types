{
  "name": "claude-code-types",
  "version": "1.5.0",
  "description": "TypeScript type definitions for Claude Code chat history JSONL files",
  "types": "./index.d.ts",
  "files": [
    "index.d.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "scan": "tsx scripts/scan-transcripts.ts",
    "test": "tsx test/smoke.local.test.ts",
    "docs": "typedoc --plugin typedoc-plugin-markdown --disableSources --readme none --out docs index.d.ts"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "types",
    "typescript",
    "jsonl",
    "chat-history"
  ],
  "author": "Pedro Paulo Vezza Campos <pedro+claude-code-types@vezza.com.br>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pedropaulovc/claude-code-types.git"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3"
  }
}
